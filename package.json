{
	"name": "n8n-nodes-azurade",
	"version": "0.1.0",
	"description": "Generate images and videos with Veo, Kling, Nano Banana and 40+ more models from n8n, paid per generation with credits that never expire",
	"license": "MIT",
	"homepage": "https://github.com/Azurade/n8n-nodes-azurade#readme",
	"keywords": [
		"n8n-community-node-package",
		"azurade",
		"image-generation",
		"video-generation",
		"veo",
		"kling",
		"nano-banana"
	],
	"author": {
		"name": "Azurade AI",
		"email": "support@azurade.com"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Azurade/n8n-nodes-azurade.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AzuradeApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Azurade/Azurade.node.js",
			"dist/nodes/Azurade/AzuradeTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
